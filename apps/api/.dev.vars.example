# 应用环境
APP_ENV=development

# 身份认证
AUTH_ACCESS_SECRET=local-access-secret-change-before-use-2026
AUTH_REFRESH_SECRET=local-refresh-secret-change-before-use-2026

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=replace-with-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:6155/auth/web/github/callback
WEB_ORIGIN=http://localhost:6153

# 跨域
CORS_ORIGINS=http://localhost:6153,http://localhost:6154

# 模型配置加密主密钥（base64 编码的 32 字节，用 openssl rand -base64 32 生成）
LLM_CONFIG_ENC_KEY=replace-with-base64-encoded-32-byte-key
