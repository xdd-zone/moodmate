{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "keep_vars": true,
  "vars": {
    "APP_ENV": "development",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "GITHUB_OAUTH_CALLBACK_URL": "http://localhost:6155/auth/web/github/callback",
    "WEB_ORIGIN": "http://localhost:6153",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moodmate-local",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AVATAR_BUCKET",
      "bucket_name": "moodmate-local-avatars",
    },
  ],
  "env": {
    "test": {
      "vars": {
        "APP_ENV": "test",
        "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
        "DEEPSEEK_MODEL": "deepseek-v4-flash",
        "GITHUB_OAUTH_CALLBACK_URL": "http://localhost:6155/auth/web/github/callback",
        "WEB_ORIGIN": "http://localhost:6153",
      },
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
        "DEEPSEEK_MODEL": "deepseek-v4-flash",
      },
    },
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
